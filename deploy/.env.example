# Internal NAS test address. Switch this to your HTTPS public domain before
# distributing the final Chrome extension, then set COOKIE_SECURE=true.
PUBLIC_ORIGIN=http://192.168.10.4:18089
COOKIE_SECURE=false
LISTEN_ADDRESS=0.0.0.0
LISTEN_PORT=18089

# NAS use a mirror for Docker Hub images and Go modules. These can be changed
# to a company registry without modifying Compose files.
POSTGRES_IMAGE=m.daocloud.io/docker.io/library/postgres:15-alpine
GO_IMAGE=m.daocloud.io/docker.io/library/golang:1.25-alpine
ALPINE_IMAGE=m.daocloud.io/docker.io/library/alpine:3.22
NODE_IMAGE=m.daocloud.io/docker.io/library/node:22-alpine
NGINX_IMAGE=m.daocloud.io/docker.io/library/nginx:1.27-alpine
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn

POSTGRES_DB=biliaudiocut
POSTGRES_USER=biliaudiocut
# Generate a unique long random value; never commit the real .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://biliaudiocut:replace-with-a-long-random-password@postgres:5432/biliaudiocut?sslmode=disable
