# The public origin is compiled into the downloadable Chrome extension.
PUBLIC_ORIGIN=https://biliaudiocut.tftocd.com
COOKIE_SECURE=true
LISTEN_ADDRESS=0.0.0.0
LISTEN_PORT=18089

# Application images are built and pushed manually from a development machine.
BACKEND_IMAGE=ghcr.io/tigerofcountryyao/biliaudiocut-backend
WEB_IMAGE=ghcr.io/tigerofcountryyao/biliaudiocut-web
APP_VERSION=stable

# Runtime dependency images pulled by the NAS.
POSTGRES_IMAGE=m.daocloud.io/docker.io/library/postgres:15-alpine
NGINX_IMAGE=m.daocloud.io/docker.io/library/nginx:1.27-alpine
CLOUDFLARED_IMAGE=m.daocloud.io/docker.io/cloudflare/cloudflared:latest

# Keep empty for LAN-only use. To enable the optional Cloudflare Tunnel profile,
# paste the remotely-managed tunnel token here. Never commit the real token.
CLOUDFLARED_TUNNEL_TOKEN=

POSTGRES_DB=biliaudiocut
POSTGRES_USER=biliaudiocut
# Generate a unique long random value; never commit the real .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://biliaudiocut:replace-with-a-long-random-password@postgres:5432/biliaudiocut?sslmode=disable
