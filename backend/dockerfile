FROM golang:1.25-alpine AS build

WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/admin ./cmd/admin \
    && go install github.com/pressly/goose/v3/cmd/goose@v3.27.3

FROM alpine:3.22 AS api

RUN apk add --no-cache ca-certificates \
    && addgroup -S app \
    && adduser -S -G app app

WORKDIR /app
COPY --from=build /out/api /app/app
USER app

ENTRYPOINT ["/app/app"]

FROM alpine:3.22 AS admin

RUN apk add --no-cache ca-certificates \
    && addgroup -S app \
    && adduser -S -G app app

WORKDIR /app
COPY --from=build /out/admin /app/admin
USER app

ENTRYPOINT ["/app/admin"]

FROM alpine:3.22 AS migrate

RUN apk add --no-cache ca-certificates

COPY --from=build /go/bin/goose /usr/local/bin/goose
COPY internal/platform/database/migrations /migrations

ENTRYPOINT ["/usr/local/bin/goose"]
