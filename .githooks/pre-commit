#!/usr/bin/env sh
set -eu

repo_root=$(git rev-parse --show-toplevel)

# Do not make documentation-only commits depend on an unrelated Go worktree.
if git diff --cached --quiet -- backend; then
  exit 0
fi

cd "$repo_root/backend"

go_files=$(find . -type f -name '*.go' -not -path './vendor/*')
if [ -n "$go_files" ]; then
  unformatted=$(gofmt -l $go_files)
  if [ -n "$unformatted" ]; then
    echo "Go files must be formatted before committing:"
    echo "$unformatted"
    echo "Run: cd backend && gofmt -w <files>"
    exit 1
  fi
fi

before_tidy=$(git -C "$repo_root" status --porcelain -- backend/go.mod backend/go.sum)
go mod tidy
after_tidy=$(git -C "$repo_root" status --porcelain -- backend/go.mod backend/go.sum)

if [ "$before_tidy" != "$after_tidy" ]; then
  echo "go mod tidy changed backend/go.mod or backend/go.sum. Review and stage the changes, then commit again."
  exit 1
fi

go test ./...
